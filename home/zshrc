### TMUX AUTO LOAD ON STARTUP
TMUX_DEFAULT_SESSION="titan"

if [[ -z "$TMUX" && "$TERM_PROGRAM" != "vscode" ]] && command -v tmux >/dev/null 2>&1; then
    if ! tmux has-session -t "$TMUX_DEFAULT_SESSION" 2>/dev/null; then
        tmux new-session -d -s "$TMUX_DEFAULT_SESSION"
    fi

    tmux -u attach -t "$TMUX_DEFAULT_SESSION"
fi
