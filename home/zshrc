### TMUX AUTO LOAD ON STARTUP
alias y='yazi'
alias c='clear'
alias nixbuild='sudo nixos-rebuild switch'

TMUX_DEFAULT_SESSION="titan"

if [[ -o interactive && -z "$TMUX" && "$TERM_PROGRAM" != "vscode" ]] \
    && command -v tmux >/dev/null 2>&1; then
    exec tmux -u new-session -A -s "$TMUX_DEFAULT_SESSION"
fi
